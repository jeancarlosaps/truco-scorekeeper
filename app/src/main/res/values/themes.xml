<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TrucoScorekeeper" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/verde_feltro</item>
        <item name="colorOnPrimary">@color/branco_carta</item>
        <item name="colorSecondary">@color/texto_ouro</item>
        <item name="colorOnSecondary">@color/verde_feltro</item>
        <item name="android:windowBackground">@color/verde_feltro</item>
    </style>

    <style name="Theme.TrucoScorekeeper.AlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:textColorPrimary">@color/branco_carta</item>
        <item name="android:textColor">@color/branco_carta</item>
        <item name="colorAccent">@color/texto_ouro</item>
    </style>
</resources>
