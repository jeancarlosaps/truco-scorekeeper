<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_feltro"
    tools:context=".EstatisticasActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/verde_feltro_dark"
        app:navigationIconTint="@color/texto_ouro"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_estatisticas_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/estatisticas_titulo"
                android:textColor="@color/texto_ouro"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingVertical="8dp" />

            <!-- Card: Vitórias -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/verde_feltro_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/texto_ouro"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/estatisticas_label_vitorias"
                        android:textColor="@color/texto_ouro"
                        android:textSize="13sp"
                        android:textAllCaps="true"
                        android:gravity="center"
                        android:letterSpacing="0.1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_estat_nome_equipe1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/branco_carta"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="Equipe A" />

                            <TextView
                                android:id="@+id/tv_estat_vitorias_equipe1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/texto_ouro"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginTop="4dp"
                                tools:text="3 vitórias" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginVertical="4dp"
                            android:background="@color/texto_ouro"
                            android:alpha="0.4" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_estat_nome_equipe2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/branco_carta"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="Equipe B" />

                            <TextView
                                android:id="@+id/tv_estat_vitorias_equipe2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/texto_ouro"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginTop="4dp"
                                tools:text="2 vitórias" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Total de Partidas -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/verde_feltro_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/texto_ouro"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/estatisticas_label_total"
                        android:textColor="@color/texto_ouro"
                        android:textSize="13sp"
                        android:textAllCaps="true"
                        android:gravity="center"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_estat_total"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/branco_carta"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        tools:text="5 partidas" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Equipe Líder -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/verde_feltro_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/texto_ouro"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/estatisticas_label_lider"
                        android:textColor="@color/texto_ouro"
                        android:textSize="13sp"
                        android:textAllCaps="true"
                        android:gravity="center"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_estat_lider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/branco_carta"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Equipe A" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Maior Sequência -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/verde_feltro_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/texto_ouro"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/estatisticas_label_sequencia"
                        android:textColor="@color/texto_ouro"
                        android:textSize="13sp"
                        android:textAllCaps="true"
                        android:gravity="center"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_estat_sequencia1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/branco_carta"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        tools:text="Equipe A — 3 vitórias seguidas" />

                    <TextView
                        android:id="@+id/tv_estat_sequencia2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/branco_carta"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        tools:text="Equipe B — 1 vitória seguida" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
