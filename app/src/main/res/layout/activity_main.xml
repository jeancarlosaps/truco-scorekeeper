<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_feltro"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tv_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/titulo_app"
            android:textColor="@color/texto_ouro"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingVertical="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Área Jogador 1 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/area_jogador1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/verde_feltro_dark"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_titulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_nome_jogador1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/jogador_1"
                android:textColor="@color/branco_carta"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_pontuacao_jogador1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/pontuacao_inicial"
                android:textColor="@color/texto_ouro"
                android:textSize="40sp"
                android:fontFamily="@font/chalkduster"
                android:gravity="center"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_nome_jogador1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/ll_botoes_jogador1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_pontuacao_jogador1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <Button
                    android:id="@+id/btn_j1_mais1"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_mais_1"
                    android:textColor="@color/vermelho_baralho"
                    android:textStyle="bold"
                    android:background="@drawable/botao_carta" />

                <Button
                    android:id="@+id/btn_j1_mais3"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_mais_3"
                    android:textColor="@color/vermelho_baralho"
                    android:textStyle="bold"
                    android:background="@drawable/botao_carta" />

                <Button
                    android:id="@+id/btn_j1_mais6"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_mais_6"
                    android:textColor="@color/vermelho_baralho"
                    android:textStyle="bold"
                    android:background="@drawable/botao_carta" />

                <Button
                    android:id="@+id/btn_j1_mais9"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_mais_9"
                    android:textColor="@color/vermelho_baralho"
                    android:textStyle="bold"
                    android:background="@drawable/botao_carta" />

                <Button
                    android:id="@+id/btn_j1_mais12"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_mais_12"
                    android:textColor="@color/vermelho_baralho"
                    android:textStyle="bold"
                    android:background="@drawable/botao_carta" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Área Jogador 2 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/area_jogador2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/verde_feltro_dark"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/area_jogador1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_nome_jogador2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/jogador_2"
                android:textColor="@color/branco_carta"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_pontuacao_jogador2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/pontuacao_inicial"
                android:textColor="@color/texto_ouro"
                android:textSize="40sp"
                android:fontFamily="@font/chalkduster"
                android:gravity="center"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_nome_jogador2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/ll_botoes_jogador2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_pontuacao_jogador2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <Button
                    android:id="@+id/btn_j2_mais1"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_mais_1"
                    android:textColor="@color/vermelho_baralho"
                    android:textStyle="bold"
                    android:background="@drawable/botao_carta" />

                <Button
                    android:id="@+id/btn_j2_mais3"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_mais_3"
                    android:textColor="@color/vermelho_baralho"
                    android:textStyle="bold"
                    android:background="@drawable/botao_carta" />

                <Button
                    android:id="@+id/btn_j2_mais6"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_mais_6"
                    android:textColor="@color/vermelho_baralho"
                    android:textStyle="bold"
                    android:background="@drawable/botao_carta" />

                <Button
                    android:id="@+id/btn_j2_mais9"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_mais_9"
                    android:textColor="@color/vermelho_baralho"
                    android:textStyle="bold"
                    android:background="@drawable/botao_carta" />

                <Button
                    android:id="@+id/btn_j2_mais12"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_mais_12"
                    android:textColor="@color/vermelho_baralho"
                    android:textStyle="bold"
                    android:background="@drawable/botao_carta" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Botões administrativos -->
        <LinearLayout
            android:id="@+id/ll_botoes_admin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/area_jogador2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_historico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/btn_historico"
                android:textColor="@color/branco_carta"
                android:textStyle="bold"
                android:backgroundTint="@color/madeira_botao" />

            <Button
                android:id="@+id/btn_zerar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/btn_zerar"
                android:textColor="@color/branco_carta"
                android:textStyle="bold"
                android:backgroundTint="@color/madeira_botao" />

            <Button
                android:id="@+id/btn_nomes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/btn_nomes"
                android:textColor="@color/branco_carta"
                android:textStyle="bold"
                android:backgroundTint="@color/madeira_botao" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
